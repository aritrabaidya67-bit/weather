# ===========================================================================
#  Backend configuration TEMPLATE
#
#  Copy to `.env` and edit:      cp .env.example .env
#  `.env` is git-ignored and must NEVER be committed: it holds the device API
#  key the Arduino authenticates with.
#
#  Every value below is a safe placeholder. Anything left out falls back to the
#  default in backend/app/core/config.py.
# ===========================================================================

# --- application -----------------------------------------------------------
APP_NAME="Environmental Intelligence Platform"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- networking ------------------------------------------------------------
# 0.0.0.0 makes the API reachable from the Arduino over the LAN/hotspot.
# Never bind to 127.0.0.1 if the node has to reach it.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ------------------------------------------------------------------
# The ONLY browser origins allowed to call this API. Wildcards are ignored
# (not honoured) so this list is always explicit. DEVELOPMENT: the Vite dev
# server. PRODUCTION: the real frontend origin, e.g. http://192.168.1.50:8080
# - and remove the localhost entries.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Convenience for demos from another device on the same LAN/hotspot: accepts
# RFC1918 origins (192.168.x.x, 10.x.x.x, 172.16-31.x.x) only. Leave false in
# production and list the exact origin in CORS_ORIGINS instead.
CORS_ALLOW_LAN_ORIGINS=false
# Optional extra origin regex. Empty by default; prefer CORS_ORIGINS.
CORS_ORIGIN_REGEX=

# --- security --------------------------------------------------------------
# The Arduino sends this in the X-API-Key header. Generate a real random value:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME value in arduino/.../config.h and keep it out of git.
# The server REFUSES to authenticate devices with a placeholder or short key
# (it answers HTTP 503 with the reason), so this line is not optional.
API_KEY=replace_with_a_long_random_device_key
# Optional separate key for administrative endpoints (falls back to API_KEY).
ADMIN_API_KEY=
# true = read endpoints also require X-API-Key (dashboard then needs a proxy).
REQUIRE_AUTH_FOR_READS=false
CHAT_RATE_LIMIT_PER_MINUTE=20
INGEST_RATE_LIMIT_PER_MINUTE=600

# --- storage ---------------------------------------------------------------
# SQLite by default; swap in PostgreSQL later without touching application code.
DATABASE_URL=sqlite:///./data/environmental.db
RETENTION_DAYS=365

# --- device ----------------------------------------------------------------
DEVICE_ID=arduino-r4-wifi-01
DEVICE_DISPLAY_NAME="Arduino UNO R4 WiFi - Environmental Node"
EXPECTED_TRANSMISSION_INTERVAL_SECONDS=15
DEVICE_OFFLINE_AFTER_SECONDS=60
STALE_READING_SECONDS=90
MAX_TIMESTAMP_SKEW_SECONDS=900
DUPLICATE_WINDOW_SECONDS=3

# --- calibration -----------------------------------------------------------
# These MUST match arduino/environmental_monitor/config.h so both sides agree
# on what a raw 10-bit ADC count means.
AIR_QUALITY_CLEAN_BASELINE=180
AIR_QUALITY_MAX_REFERENCE=850
RAIN_DRY_ADC=950
RAIN_WET_ADC=250
LIGHT_DARK_ADC=40
LIGHT_BRIGHT_ADC=900

# --- analytics / prediction ------------------------------------------------
ANALYTICS_DEFAULT_HOURS=6
PREDICTION_SNAPSHOT_INTERVAL_MINUTES=5
BACKGROUND_WORKERS_ENABLED=true
# Optional JSON file that wholesale replaces the risk model (weights + bands).
RISK_CONFIG_FILE=

# --- Ollama (existing installation; nothing is ever downloaded here) -------
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
# Where the model store lives, if it is not in the default location. Only read,
# to list what is already installed while the server is down. OLLAMA_MODELS (the
# variable Ollama itself uses) is honoured first if it is already set.
# Example: models kept off the system drive
# OLLAMA_MODELS_DIRS=D:/OllamaModels
OLLAMA_MODELS_DIRS=
# Leave empty to auto-detect from the models already installed. Set an explicit
# name to pin one, e.g. OLLAMA_MODEL=gemma3:4b (fast) or qwen3:4b (deeper).
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODELS=gemma3:4b,qwen3:4b,qwen3:8b,llama3.2:3b,mistral:7b
# Thinking models put long reasoning in a separate field; keep this false unless
# your model leaks its chain of thought into the answer.
OLLAMA_DISABLE_THINKING=false
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
CHAT_MAX_HISTORY_MESSAGES=8
CHAT_MAX_CONTEXT_CHARS=14000
