# Frontend configuration (copy to .env and adjust if needed).
# Nothing here is a secret: the browser never receives an API key.

# Base URL of the FastAPI backend. Leave empty to use same-origin requests, which
# the Vite dev server proxies to VITE_PROXY_TARGET (recommended for local dev).
VITE_API_BASE_URL=

# Where the dev server proxies /api requests to.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional explicit WebSocket origin (defaults to the API base URL / same host).
VITE_WS_URL=

# Only needed when the backend sets REQUIRE_AUTH_FOR_READS=true: the key the
# realtime WebSocket/SSE transports send (the browser WebSocket API cannot set
# headers). Leave empty for the default open-reads LAN demo.
VITE_REALTIME_API_KEY=

# Dev server port (defaults to 5173).
VITE_DEV_PORT=5173
